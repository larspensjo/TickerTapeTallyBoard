{
  "name": "ticker-tape-tally-board-frontend",
  "version": "0.33.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && biome check src index.html vite.config.ts vitest.config.ts vitest.browser.config.ts biome.json package.json tsconfig.json && vitest run --passWithNoTests",
    "fmt": "biome format --write src index.html vite.config.ts vitest.config.ts vitest.browser.config.ts biome.json package.json tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-table": "^9.3.1",
    "d3-hierarchy": "^3.1.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "@vitest/browser-playwright": "5.0.5",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
